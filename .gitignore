# Rust build output (Cargo.lock is intentionally committed for this application)
/target/
/plugins/scs-telemetry-bridge/build/
**/*.rs.bk
*.profraw
lcov.info

# Rust tooling credentials and machine-local overrides
.cargo/credentials
.cargo/credentials.toml
.cargo/config.local.toml

# JavaScript dependencies, caches, and generated output
node_modules/
dist/
coverage/
.cache/
.npm/
.pnpm-store/
.turbo/
.vite/
.eslintcache
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Dashboard assets embedded into the Rust binary are generated by the web build
/apps/host/assets/dashboard/

# Tauri icon command also emits mobile and Store assets; desktop keeps only
# the Windows/macOS icon set plus the editable SVG source.
/apps/desktop/src-tauri/icons/android/
/apps/desktop/src-tauri/icons/ios/
/apps/desktop/src-tauri/icons/Square*Logo.png
/apps/desktop/src-tauri/icons/StoreLogo.png
/apps/desktop/src-tauri/binaries/
/apps/desktop/src-tauri/resources/
/apps/desktop/src-tauri/gen/
/apps/desktop/target/

# Local environment and developer-only configuration
/.codex/
.env
.env.*
!.env.example
*.local.json
*.local.toml
.opensimdash/
/runtime/
/logs/
*.log

# Telemetry captures may contain account, lobby, or session information
/captures/
/recordings/
*.pcap
*.pcapng
*.telemetry
*.udp-capture

# Pairing secrets, update keys, and code-signing material
/secrets/
/certificates/private/
*.key
*.pem
*.p12
*.pfx
*.mobileprovision

# Crash dumps and temporary files
*.dmp
*.dump
*.tmp
*.temp
*.bak
*.orig
*~

# Editors
.idea/
.fleet/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo

# macOS
.DS_Store
._*
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
